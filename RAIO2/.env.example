MAAS_API_URL=https://api.modelarts-maas.com/v2/chat/completions
MAAS_MODEL=deepseek
JWT_SECRET=change-me

# Users enter their own MaaS API Key on the login page.
# Do not put a shared server MaaS key here for normal user traffic.

# Optional per-agent model mapping. Unset values fall back to MAAS_MODEL.
MAAS_MODEL_LUMO=deepseek
MAAS_MODEL_HOOT=deepseek
MAAS_MODEL_BOOKWORM=deepseek
MAAS_MODEL_SCHOLAR=deepseek
MAAS_MODEL_BLOOM=deepseek
MAAS_MODEL_GEARS=deepseek

# Optional per-agent endpoint overrides.
