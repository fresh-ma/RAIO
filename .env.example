MAAS_API_URL=https://api.modelarts-maas.com/v2/chat/completions
JWT_SECRET=change-me

# Users enter their own MaaS API Key on the login page.
# Users also choose the model on the login/profile page.
# Do not put a shared server MaaS key or model here for normal user traffic.

# Optional per-agent endpoint and model overrides.
# MAAS_API_URL_BOOKWORM=
# MAAS_MODEL_LUMO=deepseek-v4-flash
# MAAS_MODEL_HOOT=deepseek-v3.2
# MAAS_MODEL_BOOKWORM=deepseek-v4-pro
# MAAS_MODEL_SCHOLAR=qwen3-30b-a3b
# MAAS_MODEL_BLOOM=kimi-k2.6
# MAAS_MODEL_GEARS=qwen3-235b-a22b

# Optional: enables the Unpaywall step in the DOI full-text resolution chain.
# Use a real contact email as required by the Unpaywall API policy.
# UNPAYWALL_EMAIL=you@example.edu
